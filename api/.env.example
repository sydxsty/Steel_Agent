# LLM providers
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-v4-flash

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.8-max

# PostgreSQL / PGVector / session storage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
SESSION_DB_NAME=metal_sessions_db

# Oracle historical production data
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=ORCL
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_TABLE=match_process_valid
ORACLE_CLIENT_LIB_DIR=
ORACLE_TNS_ADMIN=

# MySQL historical production data for pipeline steel
PIPELINE_MYSQL_HOST=127.0.0.1
PIPELINE_MYSQL_PORT=3306
PIPELINE_MYSQL_DATABASE=nansteel
PIPELINE_MYSQL_USER=
PIPELINE_MYSQL_PASSWORD=
PIPELINE_MYSQL_TABLE=table_x80ng_read_valid

# RAG ingestion: set to 0 to disable MinerU
STORE_VECTORS_USE_MINERU=1
